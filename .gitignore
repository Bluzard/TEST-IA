# entorno y caché
.venv/
__pycache__/
*.pyc
*.tmp

# binarios de compilación (se regeneran con compilar_motor.bat)
*.dll
*.obj
*.lib
*.exp

# datos personales de la memoria externa
datos/memoria.json
datos/memoria_prueba.json

# pesos pesados y variantes (ver modelos/README.md): solo producción liviana va al repositorio
modelos/*.pt
modelos/**/*.safetensors
modelos/archivo/
modelos/experimentos/

# datos pesados (> 20 MB): se regeneran con corpus.py / sft_datos.py
datos/corpus_es.txt
datos/corpus_es.bin
datos/corpus_es_val.bin
datos/sft_train.jsonl
datos/sft_pool.jsonl

# documentos de terceros / sin revisar
*.pdf

# Etapa 4, Fase 1: corpus y shards (decenas de GB; se regeneran con fase1_datos.py)
datos/v2/*
!datos/v2/tokenizador_v2.json
!datos/v2/tokenizador_v2_sft.json

# respaldo de v1 (copias; los originales ya están versionados): solo el manifiesto
modelos/v1_respaldo/*
!modelos/v1_respaldo/SHA256_v1.json

# señales vacías de coordinación entre procesos
resultados/*.flag

# datos de imagen: crudos descargados y generados (se reconstruyen con imagen_datos.py)
datos/imagen/raw/
datos/imagen/*.jsonl

# pesos HF del modelo base (se descargan con huggingface_hub; ver lora3b.py)
modelos/base/

# registros por vida (≈5 MB): se regeneran con adaptacion/vidas_sucesivas.py comparar
adaptacion/resultados_vidas/
